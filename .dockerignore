# VCS / CI
.git
.github
.gitignore

# Installed/built artifacts (regenerated in the image)
node_modules
.next
out
build
.yarn/cache
.yarn/install-state.gz

# Secrets — injected at runtime via env_file, never baked into the image.
# `.env` is the runtime file (copy of .env.production with the real values) and is
# EXCLUDED so a build on the prod host can't bake secrets into image layers.
# .env.development / .env.production are KEPT: they hold the NEXT_PUBLIC_* baked at build.
.env
.env.local
.env.*.local

# Logs / misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.DS_Store

# Editor / tooling / docs
.vscode
.idea
.claude
README.md
DOCKER.md

# Source design artifacts — not part of the app image.
# The exported Figma doc + its 5.9 MB sample JPG; the assets the app actually
# uses already live in public/brand/.
initial-design

# Font originals (~3.7 MB of .otf/.ttf). Source of truth for future conversions,
# but next/font serves the .woff2 from src/fonts — these would ship for nothing.
public/fonts
