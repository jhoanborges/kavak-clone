{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": { "enabled": false },
	"files": {
		"includes": [
			"src/**",
			"!src/components",
			"!**/node_modules",
			"!**/.next",
			"!initial-design",
			"!public"
		]
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "noDescendingSpecificity": "off" }
		}
	},
	"formatter": { "enabled": false }
}
