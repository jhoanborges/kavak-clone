# Plantilla. Copia a `.env` (runtime, gitignored) y rellena los valores reales.
# Self-contained: refleja todas las claves de .env.development / .env.production.

# -- Shared --
NEXT_PUBLIC_APP_NAME="VALUE Seminuevos"
NEXT_PUBLIC_API_VERSION="1.0.0"
NEXT_PUBLIC_APP_PORT=8008
# Origin público completo (scheme + host + puerto si no es estándar).
NEXT_PUBLIC_APP_URL=http://localhost:8008

# -- API --
# CATÁLOGO TRADEIN (autos + citas): sirve /ENCABEZADO/* y /DETALLE/*.
# Server-only (sin NEXT_PUBLIC_): el cliente pasa por el proxy /api, nunca ve la IP.
# dev=172.16.0.206  prod=172.16.0.142. IP interna: requiere VPN/LAN.
# Las imágenes se sirven de {TRADEIN_URL}/thumbnail vía /api/imagen (proxy propio).
TRADEIN_URL="http://172.16.0.206/servicio_api_value_tdin"
# WEBSERVICE pre-estudio / BC (backend DISTINTO al catálogo). IP interna, requiere VPN.
# dev=172.16.0.206  prod=172.16.0.142 (aún no liberado).
NEXT_PUBLIC_PREESTUDIO_URL="http://172.16.0.206/servicio_api_value_pe_bc"

APP_ENV=development
API_TIMEOUT=60


# -- Redes sociales (footer, navbar, JSON-LD sameAs) --------------------------
# PENDIENTE: valores reales. No se pudieron scrapear de valueautos.com.mx
# (WAF de Imperva devuelve 403). Sustituir por las URLs que use Value.
# Cualquiera que se deje VACÍA no se renderiza — el footer las filtra.
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/ValueGF
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/valuegf
NEXT_PUBLIC_X=https://x.com/ValueGF
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/valuegf

# -- Contacto (footer, /contacto, JSON-LD) ------------------------------------
# PENDIENTE: valores reales, mismo motivo.
NEXT_PUBLIC_PHONE="+52(81) 1500 7513"
NEXT_PUBLIC_WHATSAPP="+52(81) 1500 7513"
NEXT_PUBLIC_EMAIL="seminuevos@value.com.mx"
NEXT_PUBLIC_ADDRESS="Calz San Pedro 202 Sur, Del Valle, 66220 San Pedro Garza García, N.L."

# -- Legal (viven en el sitio corporativo, no aquí) ---------------------------
# El footer abre estos en pestaña nueva con rel="noopener". Si se dejan vacíos
# el enlace no se renderiza.
NEXT_PUBLIC_LEGAL_TERMINOS="https://value.com.mx/normatividad/terminos-condiciones"
NEXT_PUBLIC_LEGAL_PRIVACIDAD="https://value.com.mx/normatividad#privacidad"

# -- reCAPTCHA v3 -------------------------------------------------------------
# Apagado por ahora. Con "false" no se carga el script de Google y el endpoint
# /api/recaptcha/verify responde `omitido: true` sin bloquear el envío.
# Un solo interruptor: NEXT_PUBLIC_ lo hace legible en cliente Y en servidor.
NEXT_PUBLIC_RECAPTCHA_ENABLED=false

# Pública por diseño: viaja en el HTML.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# SÓLO SERVIDOR. Nunca le pongas el prefijo NEXT_PUBLIC_: Next la hornearía en
# el bundle del cliente y quedaría publicada. Va en `.env` (gitignored), no aquí.
RECAPTCHA_SECRET_KEY=

# Token Bearer del webservice pre-estudio/BC (cotizador /api/financiamiento).
# Sólo servidor. El valor real de DESARROLLO va en `.env.local` (gitignored),
# NUNCA en este template. Sácalo del PDF "PREESTUDIO BC" (pág 2).
PREESTUDIO_TOKEN=

# Token Bearer del catálogo TRADEIN (/api/vehiculos, /api/imagen, etc.).
# Sólo servidor. El valor real de DESARROLLO va en `.env.local` (gitignored),
# NUNCA en este template. Sácalo del PDF "TRADEIN" (pág 2).
TRADEIN_TOKEN=