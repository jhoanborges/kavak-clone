# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env runtime con secretos - nunca commitear.
# `.env` = copia de `.env.production` con los secretos llenos, en el host prod.
# `.env.development` / `.env.production` SÍ se commitean: sólo llevan NEXT_PUBLIC_*
# (públicos por definición) y el Dockerfile los necesita en build time.
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
